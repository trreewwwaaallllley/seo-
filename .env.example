# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_ALLOWLIST_EMAIL: Single authorized administrator email for private access.
ADMIN_ALLOWLIST_EMAIL="mrramsain03@gmail.com"

# TOKEN_ENCRYPTION_SECRET: 32+ char key for AES-256-GCM encryption of stored OAuth tokens.
TOKEN_ENCRYPTION_SECRET=""

# Optional Google Ads API Developer Token (if connected to Google Ads Keyword Planning API)
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Google OAuth 2.0 Web Application credentials (backend-only, for Blogger & Search Console offline refresh tokens)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

